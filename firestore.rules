rules_version = '2';
// Regras de segurança do ChatMil (Firestore).
// Cole este texto em Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function imgsOk() {
      return !('imgs' in request.resource.data) || (request.resource.data.imgs is list && request.resource.data.imgs.size() <= 6);
    }
    function textoOk(campo, max) {
      return !(campo in request.resource.data) || request.resource.data[campo] == null
        || (request.resource.data[campo] is string && request.resource.data[campo].size() <= max);
    }
    // Quem recebe mensagem direta: aceita de todos, ou só de quem segue; e não bloqueou quem envia
    function podeReceber(outro) {
      return !exists(/databases/$(database)/documents/users/$(outro)/bloqueados/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(outro)).data.get('privMsg', 'todos') == 'todos'
            || exists(/databases/$(database)/documents/users/$(outro)/seguindo/$(request.auth.uid)));
    }

    // Nomes de usuário únicos (@usuario)
    match /usernames/{nome} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == eu()
        && request.resource.data.keys().hasOnly(['uid'])
        && nome.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$');
      allow delete: if logado() && resource.data.uid == eu();
    }

    // Perfis
    match /users/{uid} {
      allow read: if logado();
      allow create, update: if logado() && uid == eu()
        && request.resource.data.usuario is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usuario)).data.uid == eu()
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && textoOk('bio', 300) && textoOk('escola', 100) && textoOk('foto', 150000)
        && (request.resource.data.get('inst', false) == false
            || (request.auth.token.email_verified == true && request.auth.token.email.matches('.*[.](gov|edu)[.]br$')))
        && request.resource.data.get('privMsg', 'todos') in ['todos', 'seguindo'];
      allow delete: if logado() && uid == eu();

      // quem eu sigo: só eu vejo (pode ter "seguir em segredo"); as regras usam exists() normalmente
      match /seguindo/{outro} {
        allow read: if logado() && uid == eu();
        allow write: if logado() && uid == eu();
      }
      // seguidores: escondidos quando a pessoa ativa "esconder" (privRede)
      match /seguidores/{outro} {
        allow read: if logado() && (uid == eu() || outro == eu()
          || get(/databases/$(database)/documents/users/$(uid)).data.get('privRede', false) == false);
        allow create, delete: if logado() && outro == eu();
      }
      // cópia da chave secreta trancada pelo PIN (só a própria pessoa lê)
      match /privado/{doc} {
        allow read, write: if logado() && uid == eu();
      }
      match /bloqueados/{outro} {
        allow read, write: if logado() && uid == eu();
      }
      match /leituras/{chatId} {
        allow read, write: if logado() && uid == eu();
      }
    }

    // Conversas (diretas e grupos)
    match /chats/{chatId} {
      allow read: if logado() && eu() in resource.data.membros;

      allow create: if logado() && request.resource.data.criadoPor == eu()
        && eu() in request.resource.data.membros
        && (
          (request.resource.data.tipo == 'direto'
            && request.resource.data.membros.size() == 2
            && chatId == request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
            && (request.resource.data.membros[0] == eu() || podeReceber(request.resource.data.membros[0]))
            && (request.resource.data.membros[1] == eu() || podeReceber(request.resource.data.membros[1])))
          ||
          (request.resource.data.tipo == 'grupo'
            && request.resource.data.admins == [eu()]
            && request.resource.data.membros.size() <= 512
            && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
            && textoOk('descricao', 300) && textoOk('foto', 150000))
        );

      allow update: if logado() && (
        // mensagem nova: atualiza só a prévia da última mensagem
        (eu() in resource.data.membros && mudou().hasOnly(['ultima', 'atualizadoEm']))
        // confirmação de leitura: cada um marca só o próprio horário em lidos.{uid}
        || (eu() in resource.data.membros && mudou().hasOnly(['lidos'])
            && request.resource.data.lidos.diff(resource.data.get('lidos', {})).affectedKeys().hasOnly([eu()]))
        // administrador edita o grupo
        || (resource.data.tipo == 'grupo' && eu() in resource.data.admins
            && mudou().hasOnly(['nome', 'descricao', 'foto', 'membros', 'admins', 'codigo', 'soAdmins', 'atualizadoEm'])
            && request.resource.data.membros.size() <= 512
            && request.resource.data.admins.toSet().difference(request.resource.data.membros.toSet()).size() == 0
            && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
            && textoOk('descricao', 300) && textoOk('foto', 150000))
        // participante sai do grupo
        || (resource.data.tipo == 'grupo' && eu() in resource.data.membros && !(eu() in resource.data.admins)
            && mudou().hasOnly(['membros', 'atualizadoEm'])
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([eu()].toSet()))
        // entrada com código de convite
        || (resource.data.tipo == 'grupo' && !(eu() in resource.data.membros)
            && mudou().hasOnly(['membros', 'entrouCom', 'atualizadoEm'])
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().union([eu()].toSet())
            && get(/databases/$(database)/documents/convites/$(request.resource.data.entrouCom)).data.chatId == chatId)
      );

      match /msgs/{msgId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if logado() && eu() in chat().membros;
        allow create: if logado() && request.resource.data.autor == eu()
          && eu() in chat().membros
          && (!chat().get('soAdmins', false) || eu() in chat().admins)
          && (chat().tipo != 'direto'
              || (!exists(/databases/$(database)/documents/users/$(chat().membros[0])/bloqueados/$(eu()))
                  && !exists(/databases/$(database)/documents/users/$(chat().membros[1])/bloqueados/$(eu()))))
          && textoOk('texto', 2000) && textoOk('fig', 30)
          // criptografia de ponta a ponta: conteúdo trancado (c), chaves por participante (k), chave pública de quem enviou (spk)
          && textoOk('c', 400000) && textoOk('spk', 200)
          && (!('k' in request.resource.data) || (request.resource.data.k is map && request.resource.data.k.size() <= 520));
        allow delete: if logado() && resource.data.autor == eu();
      }
    }

    // Códigos de convite dos grupos
    match /convites/{codigo} {
      allow read: if logado();
      allow create, update: if logado() && codigo.matches('^[A-Z0-9]{6}$')
        && eu() in getAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.admins;
      allow delete: if logado()
        && eu() in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.admins;
    }

    // Mural
    match /posts/{postId} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.autor == eu()
        && textoOk('texto', 3000) && textoOk('fig', 30) && textoOk('aoVivo', 80) && imgsOk() && !('para' in request.resource.data)
        && request.resource.data.curtidas == [] && request.resource.data.nComent == 0;
      allow update: if logado() && (
        (resource.data.autor == eu() && mudou().hasOnly(['texto', 'editadoEm']) && textoOk('texto', 3000))
        || (mudou().hasOnly(['curtidas'])
            && request.resource.data.curtidas.toSet().difference(resource.data.curtidas.toSet()).hasOnly([eu()])
            && resource.data.curtidas.toSet().difference(request.resource.data.curtidas.toSet()).hasOnly([eu()]))
        || (mudou().hasOnly(['nComent'])
            && (request.resource.data.nComent == resource.data.nComent + 1 || request.resource.data.nComent == resource.data.nComent - 1))
      );
      allow delete: if logado() && resource.data.autor == eu();

      match /comentarios/{cid} {
        allow read: if logado();
        allow create: if logado() && request.resource.data.autor == eu() && textoOk('texto', 1000);
        allow delete: if logado() && (resource.data.autor == eu()
          || get(/databases/$(database)/documents/posts/$(postId)).data.autor == eu());
      }
    }

    // Mural só para algumas pessoas ("para" = lista de quem vê; o autor sempre vê)
    match /postsPriv/{postId} {
      function pp() { return get(/databases/$(database)/documents/postsPriv/$(postId)).data; }
      function vePP() { return pp().autor == eu() || eu() in pp().para; }
      allow read: if logado() && (resource.data.autor == eu() || eu() in resource.data.para);
      allow create: if logado()
        && request.resource.data.autor == eu()
        && textoOk('texto', 3000) && textoOk('fig', 30) && textoOk('aoVivo', 80) && imgsOk()
        && request.resource.data.curtidas == [] && request.resource.data.nComent == 0
        && request.resource.data.para is list && request.resource.data.para.size() > 0 && request.resource.data.para.size() <= 400;
      allow update: if logado() && (resource.data.autor == eu() || eu() in resource.data.para) && (
        (resource.data.autor == eu() && mudou().hasOnly(['texto', 'editadoEm']) && textoOk('texto', 3000))
        || (mudou().hasOnly(['curtidas'])
            && request.resource.data.curtidas.toSet().difference(resource.data.curtidas.toSet()).hasOnly([eu()])
            && resource.data.curtidas.toSet().difference(request.resource.data.curtidas.toSet()).hasOnly([eu()]))
        || (mudou().hasOnly(['nComent'])
            && (request.resource.data.nComent == resource.data.nComent + 1 || request.resource.data.nComent == resource.data.nComent - 1))
      );
      allow delete: if logado() && resource.data.autor == eu();
      match /comentarios/{cid} {
        allow read: if logado() && vePP();
        allow create: if logado() && vePP() && request.resource.data.autor == eu() && textoOk('texto', 1000);
        allow delete: if logado() && (resource.data.autor == eu() || pp().autor == eu());
      }
    }
    // Arquivos do mural (PDF, vídeo, slides…), em partes de até 700 KB. Com "para", só essas pessoas baixam.
    match /postArqs/{aid} {
      function pa() { return get(/databases/$(database)/documents/postArqs/$(aid)).data; }
      function vePA() { return pa().get('para', null) == null || pa().dono == eu() || eu() in pa().para; }
      allow read: if logado() && (resource.data.get('para', null) == null || resource.data.dono == eu() || eu() in resource.data.para);
      allow create: if logado() && request.resource.data.dono == eu()
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 20971520
        && request.resource.data.partes is int && request.resource.data.partes <= 40
        && textoOk('nome', 120)
        && (request.resource.data.get('para', null) == null || (request.resource.data.para is list && request.resource.data.para.size() <= 400));
      allow delete: if logado() && resource.data.dono == eu();
      match /partes/{pid} {
        allow read: if logado() && vePA();
        allow create: if logado() && pa().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000;
        allow delete: if logado() && pa().dono == eu();
      }
    }
    // Fotos do mural (cada tamanho em um documento de até 750 KB). Se tiver "para", só essas pessoas veem.
    match /postImgs/{iid} {
      allow read: if logado() && (resource.data.get('para', null) == null || resource.data.dono == eu() || eu() in resource.data.para);
      allow create: if logado() && request.resource.data.dono == eu()
        && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000
        && (request.resource.data.get('para', null) == null || (request.resource.data.para is list && request.resource.data.para.size() <= 400));
      allow delete: if logado() && resource.data.dono == eu();
    }

    // Arquivos enviados nas conversas (guardados em partes de até 700 KB).
    // "unica" = visualização única: quem recebe pode apagar depois de abrir.
    match /arquivos/{aid} {
      function chatDoArq(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data; }
      function arq() { return get(/databases/$(database)/documents/arquivos/$(aid)).data; }
      function membroArq() { return eu() in get(/databases/$(database)/documents/chats/$(arq().chatId)).data.membros; }
      allow read: if logado() && eu() in chatDoArq(resource.data.chatId).membros;
      allow create: if logado() && request.resource.data.dono == eu()
        && eu() in chatDoArq(request.resource.data.chatId).membros
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 20971520
        && request.resource.data.partes is int && request.resource.data.partes <= 40
        && textoOk('nome', 120) && textoOk('texto', 2000);
      allow delete: if logado() && (resource.data.dono == eu()
        || (resource.data.get('unica', false) == true && eu() in chatDoArq(resource.data.chatId).membros));
      match /partes/{pid} {
        allow read: if logado() && membroArq();
        allow create: if logado() && arq().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000;
        allow delete: if logado() && (arq().dono == eu() || (arq().get('unica', false) == true && membroArq()));
      }
      match /vistos/{uid} {
        allow read: if logado() && membroArq();
        allow create: if logado() && uid == eu() && membroArq();
        allow delete: if logado() && (arq().dono == eu() || (arq().get('unica', false) == true && membroArq()));
      }
    }

    // Chamadas de vídeo e de voz (sinalização WebRTC)
    match /chamadas/{cid} {
      function chatDe(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
      allow read: if logado() && (eu() in resource.data.membros || eu() in resource.data.tocando);
      allow create: if logado() && request.resource.data.de == eu()
        && eu() in chatDe(request.resource.data.chatId).membros
        && request.resource.data.membros == chatDe(request.resource.data.chatId).membros
        && request.resource.data.membros.size() <= 512;
      allow update: if logado() && eu() in resource.data.membros
        && mudou().hasOnly(['dentro', 'tocando', 'estado', 'atualizadoEm']);
      match /sinais/{sid} {
        allow read, delete: if logado() && (resource.data.para == eu() || resource.data.de == eu());
        allow create: if logado() && request.resource.data.de == eu()
          && eu() in get(/databases/$(database)/documents/chamadas/$(cid)).data.membros
          && request.resource.data.d is string && request.resource.data.d.size() < 20000;
      }
    }

    // Flash (24 h). "flashes": todos veem. "flashesPriv": só as pessoas da lista "para".
    function flashOk() {
      return request.resource.data.dono == eu() && request.resource.data.partes is int && request.resource.data.partes <= 20
        && textoOk('legenda', 200) && textoOk('thumb', 40000);
    }
    match /flashes/{id} {
      function f() { return get(/databases/$(database)/documents/flashes/$(id)).data; }
      allow read: if logado();
      allow create: if logado() && flashOk();
      allow delete: if logado() && resource.data.dono == eu();
      match /partes/{pid} { allow read: if logado(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /som/{pid} { allow read: if logado(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /vistos/{uid} { allow create, update: if logado() && uid == eu() && request.resource.data.keys().hasOnly(['em', 'curtiu']); allow read, delete: if logado() && f().dono == eu(); }
    }
    match /flashesPriv/{id} {
      function f() { return get(/databases/$(database)/documents/flashesPriv/$(id)).data; }
      function pode() { return f().dono == eu() || eu() in f().para; }
      allow read: if logado() && (resource.data.dono == eu() || eu() in resource.data.para);
      allow create: if logado() && flashOk() && request.resource.data.para is list && request.resource.data.para.size() <= 400;
      allow delete: if logado() && resource.data.dono == eu();
      match /partes/{pid} { allow read: if logado() && pode(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /som/{pid} { allow read: if logado() && pode(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /vistos/{uid} { allow create, update: if logado() && uid == eu() && pode() && request.resource.data.keys().hasOnly(['em', 'curtiu']); allow read, delete: if logado() && f().dono == eu(); }
    }
    // Destaques do perfil (até 5, controlado pelo app)
    match /destaques/{id} {
      function f() { return get(/databases/$(database)/documents/destaques/$(id)).data; }
      allow read: if logado();
      allow create: if logado() && flashOk();
      allow delete: if logado() && resource.data.dono == eu();
      match /partes/{pid} { allow read: if logado(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /som/{pid} { allow read: if logado(); allow create: if logado() && f().dono == eu() && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000; allow delete: if logado() && f().dono == eu(); }
      match /vistos/{uid} { allow read, delete: if logado() && f().dono == eu(); }
    }

    // Foto de perfil reservada: "seguidores" = só quem segue a pessoa; "seguindo" (antigo) = só quem a pessoa segue; "ninguem" = só ela
    match /fotos/{uid} {
      allow read: if logado() && (uid == eu()
        || (resource.data.priv == 'seguindo' && exists(/databases/$(database)/documents/users/$(uid)/seguindo/$(eu())))
        || (resource.data.priv == 'seguidores' && exists(/databases/$(database)/documents/users/$(uid)/seguidores/$(eu()))));
      allow create, update: if logado() && uid == eu() && textoOk('foto', 150000) && request.resource.data.priv in ['seguindo', 'seguidores', 'ninguem'];
      allow delete: if logado() && uid == eu();
    }

    // Vitrine educativa: todos leem; só administradores (coleção admins, criada pelo console) publicam
    match /admins/{uid} {
      allow read: if logado() && uid == eu();
    }
    function adminVit() { return exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /vitrine/{id} {
      allow read: if logado();
      allow create, update: if logado() && adminVit() && textoOk('titulo', 120) && textoOk('descricao', 1500) && textoOk('imagem', 200000)
        && textoOk('preco', 40) && textoOk('precoDe', 40)
        && (!('fotos' in request.resource.data) || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 6))
        && request.resource.data.link is string && request.resource.data.link.matches('^https://.*');
      // quem toca em "Comprar" soma 1 clique (só esse campo, só +1)
      allow update: if logado() && mudou().hasOnly(['cliques'])
        && request.resource.data.cliques == resource.data.get('cliques', 0) + 1;
      allow delete: if logado() && adminVit();
    }
    match /vitrineImgs/{iid} {
      allow read: if logado();
      allow create: if logado() && adminVit() && request.resource.data.dono == eu()
        && request.resource.data.d is bytes && request.resource.data.d.size() <= 750000;
      allow delete: if logado() && adminVit();
    }
    // Configurações gerais (ex.: chave da IA gratuita), definidas pela administração
    match /config/{id} {
      allow read: if logado();
      allow write: if logado() && adminVit();
    }
    // Resultados de busca do YouTube guardados para não gastar a cota
    match /ytcache/{k} {
      allow read: if logado();
      allow create, update: if logado() && request.resource.data.keys().hasOnly(['q', 'itens', 'ms'])
        && request.resource.data.q is string && request.resource.data.q.size() <= 200
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 10
        && request.resource.data.ms is int;
    }

    // Online / visto por último: cada um escreve só o próprio
    match /presenca/{uid} {
      allow read: if logado();
      allow write: if logado() && uid == eu() && request.resource.data.keys().hasOnly(['em', 'on']);
      allow delete: if logado() && uid == eu();
    }

    // Denúncias: qualquer pessoa conectada envia; só a administração lê (pelo console do Firebase)
    match /denuncias/{id} {
      allow create: if logado() && request.resource.data.autor == eu();
    }
  }
}
